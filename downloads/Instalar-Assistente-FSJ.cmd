@echo off
set "FSJ_INSTALLER=%~f0"
powershell.exe -NoProfile -Command "$c=[IO.File]::ReadAllText($env:FSJ_INSTALLER);try{& ([scriptblock]::Create(($c -split '#FSJ_PAYLOAD\r?\n',2)[1]))}catch{Write-Host ('Instalacao nao concluida: '+$_.Exception.Message);exit 1}"
pause
exit /b
#FSJ_PAYLOAD
$ErrorActionPreference='Stop'
Write-Host 'Instalando Assistente FSJ.Web e Assistente FSJ.VM...'
$baseFSJ=Join-Path ([Environment]::GetFolderPath('ApplicationData')) 'AssistenteFSJ'
$iconsFSJ=Join-Path $baseFSJ 'Icones'
New-Item -ItemType Directory -Path $iconsFSJ -Force | Out-Null
$webIconFSJ=Join-Path $iconsFSJ 'casa.ico'
$vmIconFSJ=Join-Path $iconsFSJ 'reserva.ico'
[IO.File]::WriteAllBytes($webIconFSJ,[Convert]::FromBase64String(''))
[IO.File]::WriteAllBytes($vmIconFSJ,[Convert]::FromBase64String(''))
# Only the pinned public CA is installed in the current user's trust store.
$certBytesFSJ=[Convert]::FromBase64String('')
$shaFSJ=[Security.Cryptography.SHA256]::Create()
try {$fingerprintFSJ=[BitConverter]::ToString($shaFSJ.ComputeHash($certBytesFSJ)).Replace('-','')} finally {$shaFSJ.Dispose()}
if ($fingerprintFSJ -ne '100DA28A51F46CB486B3DD28FB46BF75910046BFE2F32FB8E380317D53D2CF13') {throw 'Certificado diferente do esperado.'}
$certFSJ=New-Object Security.Cryptography.X509Certificates.X509Certificate2 -ArgumentList @(,$certBytesFSJ)
$storeFSJ=New-Object Security.Cryptography.X509Certificates.X509Store -ArgumentList 'Root','CurrentUser'
$storeFSJ.Open([Security.Cryptography.X509Certificates.OpenFlags]::ReadOnly)
try {$hasCertFSJ=@($storeFSJ.Certificates | Where-Object {$_.Thumbprint -eq $certFSJ.Thumbprint}).Count -gt 0} finally {$storeFSJ.Close()}
if (!$hasCertFSJ) {
 Write-Host 'Configurando o certificado publico da fazenda. Confirme a autorizacao do Windows, se solicitada.'
 $certPathFSJ=Join-Path $baseFSJ 'fsj-ca-publico.cer'
 [IO.File]::WriteAllBytes($certPathFSJ,$certBytesFSJ)
 & "$env:WINDIR\System32\certutil.exe" -user -addstore Root $certPathFSJ
 if ($LASTEXITCODE -ne 0) {throw 'O certificado nao foi autorizado. Instalacao interrompida.'}
}
$launcherFSJ=Join-Path $baseFSJ 'Abrir-Reserva.cmd'
$launchCodeFSJ=@'
@echo off
powershell.exe -NoProfile -Command "$url='https://168.196.84.147/';$client=New-Object Net.Sockets.TcpClient;try{$task=$client.ConnectAsync('192.168.77.2',8443);if($task.Wait(1800) -and $client.Connected){$url='https://192.168.77.2:8443/'}}catch{}finally{$client.Dispose()};Start-Process $url"
'@
[IO.File]::WriteAllText($launcherFSJ,$launchCodeFSJ.Replace("`n","`r`n"),[Text.Encoding]::ASCII)
$desktopFSJ=[Environment]::GetFolderPath('DesktopDirectory')
$webLinkFSJ=Join-Path $desktopFSJ 'Assistente FSJ.Web.url'
$vmLinkFSJ=Join-Path $desktopFSJ 'Assistente FSJ.VM.lnk'
$backupFSJ=Join-Path $baseFSJ ('BackupAtalhos-'+(Get-Date -Format 'yyyyMMdd-HHmmss'))
foreach ($existingFSJ in @($webLinkFSJ,$vmLinkFSJ)) {
 if(Test-Path -LiteralPath $existingFSJ){New-Item -ItemType Directory -Path $backupFSJ -Force | Out-Null;Copy-Item -LiteralPath $existingFSJ -Destination $backupFSJ}
}
[IO.File]::WriteAllText($webLinkFSJ,"[InternetShortcut]`r`nURL=https://urbanopos.github.io/Assistente.FSJ/`r`nIconFile=$webIconFSJ`r`nIconIndex=0`r`n",[Text.Encoding]::Unicode)
$shellFSJ=New-Object -ComObject WScript.Shell
$linkFSJ=$shellFSJ.CreateShortcut($vmLinkFSJ)
$linkFSJ.TargetPath=$env:ComSpec
$linkFSJ.Arguments='/c ""'+$launcherFSJ+'""'
$linkFSJ.IconLocation=$vmIconFSJ+',0'
$linkFSJ.Description='Assistente FSJ Reserva - conexao automatica local ou publica'
$linkFSJ.WindowStyle=7
$linkFSJ.Save()
# Retire only shortcuts identifiable as generated by our older installer.
foreach($oldNameFSJ in @('Assistente FSJ.url','Assistente FSJ Reserva.url')) {
 $oldFSJ=Join-Path $desktopFSJ $oldNameFSJ
 if(Test-Path -LiteralPath $oldFSJ){$contentFSJ=[IO.File]::ReadAllText($oldFSJ);if($contentFSJ.Contains('IconFile='+$iconsFSJ+'\')){New-Item -ItemType Directory -Path $backupFSJ -Force | Out-Null;Move-Item -LiteralPath $oldFSJ -Destination $backupFSJ -Force}}
}
Write-Host 'CONCLUIDO: dois icones criados na area de trabalho.'
Write-Host 'Web: casinha. VM: ramo. Nenhuma senha foi copiada.'
Write-Host 'As telas sao carregadas dos servidores ao abrir. O servidor da VM precisa estar ligado.'
